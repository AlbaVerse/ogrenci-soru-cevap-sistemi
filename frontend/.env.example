# Yerelde backend'i kendi makinenizde çalıştırıyorsanız:
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
# Canlı Render backend'ine bağlanmak için (varsayılan):
# VITE_DEV_PROXY_TARGET=https://albaverse-backend.onrender.com
VITE_API_BASE_URL=/api/v1
# Frontend ayrı bir adresten yayınlanıyorsa (Render static site vb.) MUTLAK adres verin ve
# backend'de CORS_ALLOWED_ORIGINS'e bu frontend adresini ekleyin:
# VITE_API_BASE_URL=https://albaverse-backend.onrender.com/api/v1
